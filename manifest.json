{
  "manifest_version": 3,
  "name": "YouTube Feed Filter",
  "version": "1.1.0",
  "description": "Filters out livestreams, low-view-count videos, Shorts, Mixes, Playables, and members-only content from YouTube.",
  "browser_specific_settings": {
    "gecko": {
      "id": "youtube-feed-filter@example.com",
      "strict_min_version": "109.0"
    }
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["storage"]
}
